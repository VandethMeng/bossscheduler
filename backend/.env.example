# Server
PORT=5000
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173

# AWS S3 (IAM credentials or instance role on EC2/Elastic Beanstalk)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_BUCKET_NAME=boss-scheduler
S3_APPOINTMENTS_KEY=appointments.json

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Default admin user (created on first startup if no users exist)
ADMIN_EMAIL=admin@bossscheduler.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=System Admin

# Default assistant user
ASSISTANT_EMAIL=assistant@bossscheduler.com
ASSISTANT_PASSWORD=Assistant@123456
ASSISTANT_NAME=Office Assistant
